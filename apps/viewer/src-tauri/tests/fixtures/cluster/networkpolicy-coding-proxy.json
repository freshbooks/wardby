{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": { "name": "wardby-coding-proxy", "namespace": "wardby-coding" },
  "spec": {
    "podSelector": { "matchLabels": { "app.kubernetes.io/name": "wardby-coding-proxy" } },
    "policyTypes": ["Ingress", "Egress"],
    "ingress": [
      {
        "from": [{ "podSelector": { "matchLabels": { "wardby.io/component": "coding-run" } } }],
        "ports": [
          { "protocol": "TCP", "port": 8787 },
          { "protocol": "TCP", "port": 8788 }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": { "matchLabels": { "kubernetes.io/metadata.name": "kube-system" } },
            "podSelector": { "matchLabels": { "k8s-app": "kube-dns" } }
          }
        ],
        "ports": [
          { "protocol": "UDP", "port": 53 },
          { "protocol": "TCP", "port": 53 }
        ]
      },
      {
        "to": [{ "ipBlock": { "cidr": "0.0.0.0/0", "except": ["10.0.0.0/8"] } }],
        "ports": [{ "protocol": "TCP", "port": 443 }]
      },
      { "to": [{ "podSelector": {} }], "ports": [{ "port": "metrics" }] },
      { "ports": [{ "protocol": "TCP", "port": 9000 }] }
    ]
  }
}
