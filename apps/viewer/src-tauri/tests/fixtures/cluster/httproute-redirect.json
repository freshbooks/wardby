{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": { "name": "wardby-route-redirect", "namespace": "wardby" },
  "spec": {
    "parentRefs": [{ "name": "wardby-gw" }],
    "hostnames": ["wardby.example.com"],
    "rules": [
      {
        "filters": [
          { "type": "RequestRedirect", "requestRedirect": { "scheme": "https", "statusCode": 301 } }
        ]
      }
    ]
  }
}
